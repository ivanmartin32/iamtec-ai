# Variables de Entorno - Ejemplo
# Copia este archivo a .env.local y personaliza los valores

# API Base URL
VITE_API_URL=http://localhost:3000/api

# Ambiente
VITE_ENVIRONMENT=development

# Analytics (opcional)
VITE_GA_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_CONTACT_FORM=true

# Límites y paginación
VITE_ITEMS_PER_PAGE=9
VITE_MAX_FILE_SIZE=5242880

# URLs externas
VITE_SOCIAL_TWITTER=https://twitter.com/iamtec
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/iamtec
VITE_SOCIAL_INSTAGRAM=https://instagram.com/iamtec
VITE_SOCIAL_FACEBOOK=https://facebook.com/iamtec
